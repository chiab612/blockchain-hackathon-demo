// 指定 Solidity 編譯器版本
pragma solidity ^0.8.0;

// 定義一個名為 SimpleStorage 的合約
contract SimpleStorage {

    // 宣告一個狀態變數 `storedMessage` 來儲存字串，`public` 會自動生成一個 getter 函數
    string public storedMessage;

    // 宣告一個事件，當訊息被更新時觸發
    event MessageChanged(string oldMessage, string newMessage);

    // 建構子函數，在合約部署時執行一次 (可選，這裡用來設置初始訊息)
    constructor(string memory initialMessage) {
        storedMessage = initialMessage;
    }

    // 一個公共函數 `setMessage`，允許任何人傳入一個新的字串來更新 `storedMessage`
    function setMessage(string memory _newMessage) public {
        // 記錄舊訊息
        string memory oldMessage = storedMessage;
        // 更新狀態變數
        storedMessage = _newMessage;
        // 觸發事件，通知外部監聽者訊息已更改
        emit MessageChanged(oldMessage, _newMessage);
    }

    // 由於 `storedMessage` 是 public 的，Solidity 會自動為我們生成一個 getter 函數
    // function getMessage() public view returns (string memory) {
    //     return storedMessage;
    // }
    // 所以上面這個 getMessage 函數其實可以不用寫，直接調用 storedMessage() 即可讀取
}
